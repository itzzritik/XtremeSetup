#!/bin/bash
input=$(cat)
time="Time: $(TZ=Asia/Kolkata date '+%-I:%M%p') IST."

if [ -n "$AIONUI_CONVERSATION_ID" ] && [ -f "$AIONUI_DATA_DIR/aionui-backend.db" ]; then
    row=$(sqlite3 "$AIONUI_DATA_DIR/aionui-backend.db" "SELECT COALESCE(au.display_name, u.username, 'User') || '|' || COALESCE(c.source, 'web') FROM conversations c LEFT JOIN users u ON c.user_id = u.id LEFT JOIN assistant_users au ON c.channel_chat_id = au.platform_user_id WHERE c.id = '$AIONUI_CONVERSATION_ID'")
    text="User: ${row%%|*}. Platform: ${row#*|} (AionUi). $time"
else
    text="User: $(git config --global user.name). $time"
fi

if [ "$1" = antigravity ]; then
    [ "$(jq -r '.invocationNum // 0' <<< "$input" 2>/dev/null)" = 0 ] || { echo '{}'; exit 0; }
    jq -cn --arg t "$text" '{injectSteps: [{ephemeralMessage: $t}]}'
else
    jq -cn --arg t "$text" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $t}}'
fi
