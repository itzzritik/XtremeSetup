export PATH="{{ local_bin }}:{{ go_bin }}:{{ fnm_dir }}:{{ bun_bin }}:$PATH"
export BUN_INSTALL="{{ bun_bin | dirname }}"
eval "$(fnm env --use-on-cd --shell zsh)"
export EDITOR="code --wait"
alias cc="claude"
alias agyy="agy --dangerously-skip-permissions"
alias t="tmux new-session -A -s main"
alias ls="eza --icons"
alias ll="eza -la --icons --git"

vscode() {
  local uri="vscode://vscode-remote/ssh-remote+{{ user }}@{{ ansible_host }}$(realpath ${1:-.})?windowId=_blank"
  ${BROWSER:-echo} "$uri"
}

kp() {
  [ $# -eq 0 ] && {
    echo "kp - kill processes on given ports"
    echo "Usage: kp <port>...   e.g. kp 8080 8081"
    return 1
  }
  local port pids
  pids=$(for port in "$@"; do ss -ltnpH "sport = :$port" 2>/dev/null; done | grep -oP 'pid=\K[0-9]+' | sort -u)
  [ -z "$pids" ] && { echo "No processes on: $*"; return 0; }
  echo "$pids" | xargs kill -9 && echo "Killed: $(echo $pids | tr '\n' ' ')"
}

[[ -t 1 && -r ~/.cache/oci-cost ]] && print -P "Oracle dues %F{238}│%f %F{yellow}$(<~/.cache/oci-cost)%f"

[[ "$TERM_PROGRAM" == "vscode" ]] && (( $+commands[code] )) && . "$(code --locate-shell-integration-path zsh)"
